# Export these variables in the shell before running scripts.
SLIMKV_DATA_ROOT=/path/to/long-llm
SLIMKV_BASE_MODEL_DIR=/path/to/base-models
SLIMKV_OUTPUT_DIR=/path/to/slimkv-outputs
MODEL_NAME_OR_PATH=/path/to/slimkv-checkpoint
CUDA_VISIBLE_DEVICES=0
NPROC_PER_NODE=1
# Optional for Slurm templates; otherwise use the already active environment.
# SLIMKV_CONDA_ENV=slimkv

# Optional: empty skips CUDA module loading and uses the active environment.
# SLIMKV_CUDA_MODULE=
